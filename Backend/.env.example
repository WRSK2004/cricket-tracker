# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key (used to generate coaching feedback)
ANTHROPIC_API_KEY=

# Frontend address(es) allowed to call the API, comma-separated
ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501

# Firebase Storage bucket
STORAGE_BUCKET=dissertation-4cc1f.firebasestorage.app

# Path to the Firebase service-account key. If unset, Backend/serviceAccountKey.json
# is used when present, otherwise the platform's default credentials.
# FIREBASE_CREDENTIALS=

# Largest video upload accepted (MB) and how long video links last (minutes)
MAX_UPLOAD_MB=100
SIGNED_URL_MINUTES=60

# FFmpeg executable, if it is not on your PATH
# FFMPEG_PATH=C:/path/to/ffmpeg/bin/ffmpeg.exe
