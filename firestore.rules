rules_version = '2';

// ============================================================
// Firestore Security Rules
// Signed-in users can only read and write their own data.
// The backend uses the Admin SDK, which is not affected by these rules.
// Deploy with: firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- User Profiles and Health Metrics ----
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---- Practice Sessions ----
    match /practice_sessions/{sessionId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionName is string
        && request.resource.data.sessionName.size() <= 100;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // ---- Analysis Results (written only by the backend) ----
    match /analyses/{analysisId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // ---- Everything Else is Denied ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
