rules_version = '2';

// ============================================================
// Cloud Storage Security Rules
// No direct client access. Videos and frames are uploaded and
// served by the backend, which gives users short-lived links
// to their own files only.
// Deploy with: firebase deploy --only storage
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
